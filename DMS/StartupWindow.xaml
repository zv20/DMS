<Window
    x:Class="DMS.StartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DMS">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="500" Margin="24">
            <Border Width="150" Height="150" CornerRadius="24" Background="White" HorizontalAlignment="Center">
                <Image Source="Assets/logo.png" Stretch="Uniform" />
            </Border>
            <TextBlock Text="DMS" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="Subtitle" Text="Preparing your kitchen..." FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <ProgressRing x:Name="LoadingIndicator" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" />
            <TextBox x:Name="ErrorDetails" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Stretch" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button x:Name="RetryButton" Content="Try again" Visibility="Collapsed" Click="RetryButton_Click" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
