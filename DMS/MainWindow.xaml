<Window
    x:Class="DMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DMS">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48"
              Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="NavArea" Grid.Column="1">
            <StackPanel x:Name="NavView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="DmsAccentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="DmsAccentHoverBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="DmsAccentPressedBrush" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                </StackPanel.Resources>
                <ToggleButton x:Name="NavMenu" Tag="menu" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Calendar" /><TextBlock x:Uid="TitleNavMenu" x:Name="LabelMenu" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NavRecipes" Tag="recipes" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="F0 M 2,3 L 9,3 C 10.2,3 11.3,3.4 12,4.2 C 12.7,3.4 13.8,3 15,3 L 22,3 L 22,19 L 15,19 C 13.5,19 12.5,19.6 12,20.5 C 11.5,19.6 10.5,19 9,19 L 2,19 Z M 4,5 L 4,17 L 9,17 C 9.8,17 10.5,17.1 11,17.4 L 11,6 C 10.5,5.3 9.8,5 9,5 Z M 13,6 L 13,17.4 C 13.5,17.1 14.2,17 15,17 L 20,17 L 20,5 L 15,5 C 14.2,5 13.5,5.3 13,6 Z" /><TextBlock x:Uid="TitleNavRecipes" x:Name="LabelRecipes" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NavIngredients" Tag="ingredients" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="F0 M 2,21 L 5,17 C 3,13 5,9 8,6 C 11,3 16,2 22,2 C 22,8 21,13 18,16 C 15,19 11,20 7,18 L 4,22 Z M 8,16.5 C 11,18 14,17.5 16.5,15 C 18.5,13 19.5,9 20,4 C 15,4.5 11,5.5 9,7.5 C 6.5,10 6,13 7,15.5 C 10,12.5 14,9.5 18,7 C 14,10.5 11,13.5 8,16.5 Z" /><TextBlock x:Uid="TitleNavIngredients" x:Name="LabelIngredients" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <Image Source="Assets/logo.png" Width="36" Height="36" Margin="8,0" />
                <ToggleButton x:Name="NavAllergens" Tag="allergens" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="F0 M 12,2 L 23,21 L 1,21 Z M 12,6 L 4.5,19 L 19.5,19 Z M 11,10 L 13,10 L 13,15 L 11,15 Z M 11,16.5 L 13,16.5 L 13,18 L 11,18 Z" /><TextBlock x:Uid="TitleNavAllergens" x:Name="LabelAllergens" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NavTemplates" Tag="templateBuilder" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Edit" /><TextBlock x:Uid="TitleNavTemplates" x:Name="LabelTemplates" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NavSettings" Tag="settings" Click="Navigation_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Setting" /><TextBlock x:Uid="TitleNavSettings" x:Name="LabelSettings" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="{ThemeResource DmsAccentBrush}" BorderThickness="0,3,0,0">
            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
        </Border>
        <Grid x:Name="OutputOverlay" Grid.Row="1" Background="#99000000" Visibility="Collapsed" KeyDown="OutputOverlay_KeyDown">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="12" Margin="16" MaxWidth="1150" MaxHeight="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Button x:Name="CloseOutputButton" HorizontalAlignment="Right" Margin="12,8,12,0" Click="CloseOutput_Click" />
                    <Frame x:Name="OutputFrame" Grid.Row="1" IsNavigationStackEnabled="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
