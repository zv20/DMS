<Window
    x:Class="DMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DMS">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar / Header -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Height="48">
            <Grid Background="{ThemeResource DmsClassicSurfaceOverlayBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + App Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="32" Height="32" Margin="0,0,8,0" />
                    <TextBlock Text="DMS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Background="{ThemeResource DmsClassicPageOverlayBrush}" />
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="64"
            OpenPaneLength="300"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked"
            Background="Transparent">

            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DmsAccentBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DmsAccentHoverBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="DmsAccentPressedBrush" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="White" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="White" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="White" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="White" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavMenu" Tag="menu" Content="Menu Planner">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRecipes" Tag="recipes" Content="Recipes">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavIngredients" Tag="ingredients" Content="Ingredients">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAllergens" Tag="allergens" Content="Allergens">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Important" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="NavTemplateBuilder" Tag="templateBuilder" Content="Template Builder">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Frame for page navigation -->
            <Frame x:Name="ContentFrame" Margin="0" />
        </NavigationView>
        </Grid>
        <Grid x:Name="OutputOverlay" Grid.Row="1" Background="#99000000" Visibility="Collapsed" KeyDown="OutputOverlay_KeyDown">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" Margin="16" MaxWidth="1150" MaxHeight="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Button x:Name="CloseOutputButton" HorizontalAlignment="Right" Margin="12,8,12,0" Click="CloseOutput_Click" />
                    <Frame x:Name="OutputFrame" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
