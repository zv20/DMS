<Window
    x:Class="DMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DMS"
    MinWidth="1000"
    MinHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar / Header -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Height="48">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + App Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="32" Height="32" Margin="0,0,8,0" />
                    <TextBlock Text="DMS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Language Switcher + Sync Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center" Spacing="12">
                    <TextBlock x:Uid="SyncIndicator" Text="✓ Saved" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    <ComboBox x:Name="LanguageSelector" Width="100" SelectionChanged="LanguageSelector_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Tag="bg" Content="🇧🇬" />
                        <ComboBoxItem Tag="en" Content="🇺🇸" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavMenu" Tag="menu" Content="📅 Menu Planner" />
                <NavigationViewItem x:Uid="NavRecipes" Tag="recipes" Content="🍽️ Recipes" />
                <NavigationViewItem x:Uid="NavIngredients" Tag="ingredients" Content="🥕 Ingredients" />
                <NavigationViewItem x:Uid="NavAllergens" Tag="allergens" Content="⚠️ Allergens" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="NavTemplateBuilder" Tag="templateBuilder" Content="📝 Template Builder" />
                <NavigationViewItem x:Uid="NavSettings" Tag="settings" Content="⚙️ Settings" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0" />
        </NavigationView>
    </Grid>
</Window>