<Page
    x:Class="DMS.Views.AllergensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,16,16,8" Spacing="8">
            <Button x:Name="AddAllergenButton" Content="➕ Add Allergen" Click="AddAllergenButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Add_Allergen_a0c094" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search allergens..." Width="300" QueryIcon="Find" TextChanged="SearchBox_TextChanged"  x:Uid="Text_Search_allergens_c1743a" />
        </StackPanel>

        <!-- Allergen List -->
        <ListView
            x:Name="AllergensListView"
            Grid.Row="1"
            Padding="8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="AllergensListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AllergenItemViewModel">
                    <Border BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <!-- Color Indicator -->
                            <Border Width="24" Height="24" Background="{x:Bind ColorBrush}" CornerRadius="4" VerticalAlignment="Center" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="1" />
                            <StackPanel Spacing="4" VerticalAlignment="Center" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Icon}" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="✏️" ToolTipService.ToolTip="Edit" Click="EditAllergenButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Edit_530164" />
                                <Button Content="🗑️" ToolTipService.ToolTip="Delete" Click="DeleteAllergenButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"  x:Uid="Text_Delete_f6fdbe" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="⚠️" FontSize="64" />
            <TextBlock Text="No allergens yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"  x:Uid="Text_No_allergens_yet_6f883b" />
            <TextBlock Text="Click 'Add Allergen' to create your first allergen" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center"  x:Uid="Text_Click_Add_Allergen_to_create_your_first_allergen_4c030d" />
        </StackPanel>
    </Grid>
</Page>
