<Page
    x:Class="DMS.Views.AllergensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EditorColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="ListToolbar" Grid.Row="0" Padding="16,16,16,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button x:Name="AddAllergenButton" Content="➕ Add Allergen" Click="AddAllergenButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Add_Allergen_a0c094" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search allergens..." QueryIcon="Find" TextChanged="SearchBox_TextChanged"  x:Uid="Text_Search_allergens_c1743a" />
        </Grid>

        <TextBlock x:Name="PageStatus" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

        <!-- Allergen List -->
        <ListView
            x:Name="AllergensListView"
            Grid.Row="2"
            Padding="16,4,16,12"
            HorizontalContentAlignment="Stretch"
            ItemContainerStyle="{StaticResource ListCardItemStyle}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="AllergensListView_ItemClick">
            <ListView.Resources>
                <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
                <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="DmsAccentSubtleBrush" />
                <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="DmsAccentSubtlePressedBrush" />
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AllergenItemViewModel">
                    <Border Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <!-- Color Indicator -->
                            <Border Width="36" Height="36" Background="{x:Bind ColorBrush}" CornerRadius="8" VerticalAlignment="Center"><TextBlock Text="{x:Bind Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Spacing="4" VerticalAlignment="Center" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind DisplayName}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="2" VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit" Click="EditAllergenButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" x:Uid="Text_Edit_530164"><FontIcon Glyph="&#xE70F;" FontSize="14" /></Button>
                                <Button ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete" Click="DeleteAllergenButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" x:Uid="Text_Delete_f6fdbe"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="⚠️" FontSize="64" />
            <TextBlock x:Name="EmptyStateTitle" Text="No allergens yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"  x:Uid="Text_No_allergens_yet_6f883b" />
            <TextBlock x:Name="EmptyStateHint" Text="Click 'Add Allergen' to create your first allergen" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center"  x:Uid="Text_Click_Add_Allergen_to_create_your_first_allergen_4c030d" />
            <Button x:Name="ClearSearchButton" HorizontalAlignment="Center" Click="ClearSearch_Click" Visibility="Collapsed" x:Uid="ClearSearch" />
        </StackPanel>
        <Border x:Name="EditorPanel" Grid.Column="1" Grid.RowSpan="3" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="EditorCloseButton" Grid.Column="1" Content="✕" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="EditorContent" Spacing="12" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EditorSaveButton" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EditorCancelButton" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
