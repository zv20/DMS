<Page x:Class="DMS.Views.TemplateOutputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,12" Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                <ComboBox x:Name="TemplateSelector" MinWidth="180" VerticalAlignment="Bottom" DisplayMemberPath="Name" SelectionChanged="TemplateSelector_SelectionChanged" />
                <CalendarDatePicker x:Name="WeekPicker" VerticalAlignment="Bottom" DateChanged="WeekPicker_DateChanged" />
                <Button x:Name="PrintButton" VerticalAlignment="Bottom" Click="Print_Click" IsEnabled="False" />
                <Button x:Name="PdfButton" VerticalAlignment="Bottom" Click="Pdf_Click" IsEnabled="False" />
                <Button x:Name="PngButton" VerticalAlignment="Bottom" Click="Png_Click" IsEnabled="False" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" />
        <Viewbox Grid.Row="2" Margin="16" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl x:Name="PreviewHost" />
        </Viewbox>
    </Grid>
</Page>
