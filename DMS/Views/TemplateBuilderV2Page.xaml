<Page x:Class="DMS.Views.TemplateBuilderV2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Orientation="Horizontal" Padding="16,12" Spacing="10">
            <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <CalendarDatePicker x:Name="WeekPicker" DateChanged="WeekPicker_DateChanged" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <Border Width="794" Height="1123" Background="White" HorizontalAlignment="Center" Padding="40">
                <Grid RowDefinitions="60,36,*,40">
                    <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="Bold" Foreground="Black" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="DateText" Grid.Row="1" FontSize="14" Foreground="Black" TextAlignment="Center" />
                    <Grid x:Name="DaysGrid" Grid.Row="2" RowSpacing="6" />
                    <TextBlock x:Name="FooterText" Grid.Row="3" FontSize="11" Foreground="Black" TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
