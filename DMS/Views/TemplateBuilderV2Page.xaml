<Page x:Class="DMS.Views.TemplateBuilderV2Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowDefinitions="Auto,*,Auto">
  <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
   <StackPanel Orientation="Horizontal" Padding="12,8" Spacing="8">
    <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    <ComboBox x:Name="TemplateSelector" Width="190" DisplayMemberPath="Name" SelectionChanged="TemplateSelector_SelectionChanged" />
    <Button x:Name="NewButton" Click="New_Click" /><Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
    <CalendarDatePicker x:Name="WeekPicker" DateChanged="WeekPicker_DateChanged" />
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="Workspace" Grid.Row="1" ColumnDefinitions="*,Auto">
   <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" Padding="24"><ContentControl x:Name="PageHost" HorizontalAlignment="Center" /></ScrollViewer>
   <Border Grid.Column="1" Width="270" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"><StackPanel Spacing="10">
    <TextBox x:Name="NameBox" TextChanged="Fields_Changed" /><TextBox x:Name="HeaderBox" TextChanged="Fields_Changed" />
    <TextBox x:Name="FooterBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300" TextChanged="Fields_Changed" /><TextBlock x:Name="FooterHint" TextWrapping="Wrap" />
    <NumberBox x:Name="FontBox" Minimum="10" Maximum="18" SpinButtonPlacementMode="Compact" ValueChanged="Numbers_Changed" />
    <NumberBox x:Name="MinimumFontBox" Minimum="10" Maximum="18" SpinButtonPlacementMode="Compact" ValueChanged="Numbers_Changed" />
    <CheckBox x:Name="AllowShrinkBox" Checked="Shrink_Changed" Unchecked="Shrink_Changed" />
    <CheckBox x:Name="HideEmptyDaysBox" Checked="HideEmptyDays_Changed" Unchecked="HideEmptyDays_Changed" />
    <ComboBox x:Name="FontFamilyBox" HorizontalAlignment="Stretch" SelectionChanged="FontFamily_Changed" />
    <StackPanel x:Name="ColorControls" Spacing="6" />
    <Button x:Name="ChooseImageButton" Click="ChooseImage_Click" />
    <Button x:Name="ClearImageButton" Click="ClearImage_Click" />
    <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="ImageOpacity_Changed" />
    <TextBlock x:Name="DayHint" TextWrapping="Wrap" /><StackPanel x:Name="DayControls" Spacing="6" />
   </StackPanel></ScrollViewer></Border>
   <Canvas x:Name="SelectionOverlay" Grid.Column="0" Canvas.ZIndex="10">
    <Border x:Name="SelectionOutline" IsHitTestVisible="False" BorderBrush="DodgerBlue" BorderThickness="2" Visibility="Collapsed" />
    <Border x:Name="SelectionToolbar" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="1" CornerRadius="6" Padding="5" Visibility="Collapsed">
     <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><StackPanel x:Name="ContextTools" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
    </Border>
   </Canvas>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="12,6" TextWrapping="Wrap" />
 </Grid>
</Page>
