<Page x:Class="DMS.Views.MenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowDefinitions="Auto,*">
  <Grid x:Name="MenuHeader" Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" SizeChanged="MenuHeader_SizeChanged">
   <ScrollViewer x:Name="HeaderScroll" Grid.Column="0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
   <StackPanel x:Name="HeaderActions" Orientation="Horizontal" Spacing="8">
    <Button x:Name="MonthlyButton" Content="Monthly" Click="Monthly_Click" x:Uid="Text_Monthly_d31edb" /><Button x:Name="WeeklyButton" Content="Weekly" Click="Weekly_Click" x:Uid="Text_Weekly_158f3d" />
    <Button Content="←" Click="Previous_Click"/><Button Content="Today" Click="Today_Click" x:Uid="Text_Today_24345a" /><Button Content="→" Click="Next_Click"/>
   </StackPanel></ScrollViewer>
   <TextBlock x:Name="PeriodLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap"/>
   <StackPanel x:Name="OutputActions" Grid.Column="2" Orientation="Horizontal" Spacing="8">
    <Button x:Name="PrintOutputButton" Click="PrintOutput_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Print" /><TextBlock x:Uid="MenuPrint" /></StackPanel></Button>
    <Button x:Name="ExportOutputButton" Click="ExportOutput_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Share" /><TextBlock x:Uid="MenuExport" /></StackPanel></Button>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="CalendarScrollViewer" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="CalendarScrollViewer_SizeChanged">
   <Grid x:Name="CalendarGrid" Padding="16" ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Stretch"/>
  </ScrollViewer>
 </Grid>
</Page>
