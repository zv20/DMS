<Page
    x:Class="DMS.Views.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,16,16,8" Spacing="8">
            <Button x:Name="PrevWeekButton" Content="← Prev Week" Click="PrevWeekButton_Click" Style="{StaticResource ButtonRevealStyle}" />
            <Button x:Name="NextWeekButton" Content="Next Week →" Click="NextWeekButton_Click" Style="{StaticResource ButtonRevealStyle}" />
            <Button x:Name="TodayButton" Content="Today" Click="TodayButton_Click" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" />
            <TextBlock x:Name="WeekLabel" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Margin="16,0,0,0" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search recipes..." Width="250" QueryIcon="Find" TextChanged="SearchBox_TextChanged" Margin="16,0,0,0" />
            <Button x:Name="ClearWeekButton" Content="Clear Week" Click="ClearWeekButton_Click" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Weekly Grid -->
        <ScrollViewer Grid.Row="1" Padding="16" HorizontalScrollMode="Auto" VerticalScrollMode="Auto">
            <Grid x:Name="WeekGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>