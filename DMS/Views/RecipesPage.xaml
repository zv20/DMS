<Page
    x:Class="DMS.Views.RecipesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="RecipeToolbar" Grid.Row="0" Padding="16,16,16,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" SizeChanged="RecipeToolbar_SizeChanged">
            <Button x:Name="AddRecipeButton" Content="➕ Add Recipe" Click="AddRecipeButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Add_Recipe_09855a" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search recipes..." QueryIcon="Find" TextChanged="SearchBox_TextChanged"  x:Uid="Text_Search_recipes_ba1ee4" />
            <ComboBox x:Name="CategoryFilter" Grid.Column="2" Width="160" SelectionChanged="Filter_SelectionChanged" />
            <ComboBox x:Name="SortField" Grid.Column="3" Width="160" SelectionChanged="Filter_SelectionChanged" />
            <Button x:Name="SortDirectionButton" Grid.Column="4" Content="↑" Click="SortDirection_Click" />
        </Grid>

        <TextBlock x:Name="PageStatus" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

        <!-- Recipe List -->
        <ListView
            x:Name="RecipesListView"
            Grid.Row="2"
            Padding="16,4,16,12"
            HorizontalContentAlignment="Stretch"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="RecipesListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:RecipeItemViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind CategoryDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind PortionDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind CaloriesDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind IngredientsDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind AllergensDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit" Click="EditRecipeButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" x:Uid="Text_Edit_530164"><FontIcon Glyph="&#xE70F;" FontSize="14" /></Button>
                                <Button ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete" Click="DeleteRecipeButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" x:Uid="Text_Delete_f6fdbe"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="🍽️" FontSize="64" />
            <TextBlock x:Name="EmptyStateTitle" Text="No recipes yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"  x:Uid="Text_No_recipes_yet_0e52a2" />
            <TextBlock x:Name="EmptyStateHint" Text="Click 'Add Recipe' to create your first recipe" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center"  x:Uid="Text_Click_Add_Recipe_to_create_your_first_recipe_056e9d" />
            <Button x:Name="ClearSearchButton" HorizontalAlignment="Center" Click="ClearSearch_Click" Visibility="Collapsed" x:Uid="ClearFilters" />
        </StackPanel>
        <Border x:Name="RecipeEditor" Grid.Column="1" Grid.RowSpan="3" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="EditorCloseButton" Grid.Column="1" Content="✕" Click="EditorClose_Click" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="EditorContent" Spacing="12" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EditorSaveButton" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EditorCancelButton" Click="EditorClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
