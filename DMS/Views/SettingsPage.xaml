<Page
    x:Class="DMS.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="SettingsScrollViewer" Padding="24" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsCards" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch">
            <!-- Language Section -->
            <Border x:Name="LanguageCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="12">
                    <TextBlock Text="🌐 Language &amp; Region" Style="{StaticResource PageTitleTextStyle}"  x:Uid="Text_Language_Region_5d78df" />
                    <ComboBox x:Name="LanguageComboBox" Header="Language" SelectionChanged="LanguageComboBox_SelectionChanged" x:Uid="Text_Language_89b86a">
                        <ComboBoxItem Tag="bg" Content="🇧🇬 Bulgarian"  x:Uid="Text_Bulgarian_a7a43a" />
                        <ComboBoxItem Tag="en" Content="🇺🇸 English"  x:Uid="Text_English_531f36" />
                    </ComboBox>
                    <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </Border>

            <!-- Theme Section -->
            <Border x:Name="AppearanceCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="12">
                    <TextBlock Text="🎨 Appearance" Style="{StaticResource PageTitleTextStyle}"  x:Uid="Text_Appearance_be0e75" />
                    <ComboBox x:Name="ThemeComboBox" Header="Theme" SelectionChanged="ThemeComboBox_SelectionChanged" x:Uid="Text_Theme_a797e3">
                        <ComboBoxItem Tag="default" Content="Default" x:Uid="ThemeClassicDefault" />
                        <ComboBoxItem Tag="light" Content="☀️ Light"  x:Uid="Text_Light_200060" />
                        <ComboBoxItem Tag="dark" Content="🌙 Dark"  x:Uid="Text_Dark_9cc40d" />
                        <ComboBoxItem Tag="system" Content="💻 System Default"  x:Uid="Text_System_Default_363703" />
                    </ComboBox>
                    <TextBlock x:Name="ClassicAccentHint" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ComboBox x:Name="AccentColorComboBox" Header="Accent Color" SelectionChanged="AccentColorComboBox_SelectionChanged" Margin="0,8,0,0" x:Uid="Text_Accent_Color_2bef52">
                        <ComboBoxItem Tag="blue" Content="🔵 Blue"  x:Uid="Text_Blue_b81516" />
                        <ComboBoxItem Tag="green" Content="🟢 Green"  x:Uid="Text_Green_f66748" />
                        <ComboBoxItem Tag="purple" Content="🟣 Purple"  x:Uid="Text_Purple_a14112" />
                        <ComboBoxItem Tag="orange" Content="🟠 Orange"  x:Uid="Text_Orange_ed1c11" />
                        <ComboBoxItem Tag="red" Content="🔴 Red"  x:Uid="Text_Red_6f6efe" />
                        <ComboBoxItem Tag="teal" Content="🟢 Teal"  x:Uid="Text_Teal_ee7cb9" />
                    </ComboBox>
                    <TextBlock x:Name="AppearanceStatus" TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </Border>

            <!-- Planning Section -->
            <Border x:Name="PlanningCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="12">
                    <TextBlock Text="📅 Planning" Style="{StaticResource PageTitleTextStyle}" x:Uid="Text_Planning_53aa11" />
                    <ToggleSwitch x:Name="WeekendPlanningToggle" Header="Weekend menus" OffContent="Weekdays only" OnContent="Include Saturday and Sunday" Toggled="WeekendPlanningToggle_Toggled" x:Uid="Text_Weekend_Planning_53aa12" />
                    <TextBlock Text="Weekend days are disabled by default." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" x:Uid="Text_Weekend_Planning_Hint_53aa13" />
                    <TextBlock x:Name="PlanningStatus" TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </Border>

            <!-- Data Management Section -->
            <Border x:Name="DataCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="12">
                    <TextBlock Text="💾 Data Management" Style="{StaticResource PageTitleTextStyle}"  x:Uid="Text_Data_Management_a0cf50" />
                    
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="FullBackupHint" />
                        <Button x:Name="BackupButton" Content="💾 Create Backup" Click="BackupButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Create_Backup_67fc28" />
                        <Button x:Name="RestoreButton" Content="🔄 Restore Backup" Click="RestoreButton_Click" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Restore_Backup_0e7200" />
                        <TextBlock x:Name="DataStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="OpenDataFolderButton" Content="📁 Open Data Folder" Click="OpenDataFolderButton_Click" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Open_Data_Folder_7f4c75" />
                        <TextBlock x:Name="DataFolderText" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Database Section -->
            <Border x:Name="DatabaseCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="12">
                    <TextBlock Text="🗄️ Database" Style="{StaticResource PageTitleTextStyle}"  x:Uid="Text_Database_0038a1" />
                    <TextBlock x:Name="DatabaseInfoText" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DatabaseStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="VacuumButton" Content="🧹 Vacuum Database" Click="VacuumButton_Click" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Vacuum_Database_c3255f" />
                        <Button x:Name="ReindexButton" Content="📇 Reindex" Click="ReindexButton_Click" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Reindex_70aa2b" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Local diagnostic log -->
            <Border x:Name="LogsCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                    <StackPanel Margin="24" Spacing="10">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" x:Uid="LogViewerTitle" />
                        <TextBlock TextWrapping="Wrap" x:Uid="LogViewerHint" />
                        <ComboBox x:Name="LogViewerFilterComboBox" SelectionChanged="LogViewerFilter_SelectionChanged">
                            <ComboBoxItem Tag="All" x:Uid="LogFilterAll" />
                            <ComboBoxItem Tag="Information" x:Uid="LogFilterInformation" />
                            <ComboBoxItem Tag="Warning" x:Uid="LogFilterWarning" />
                            <ComboBoxItem Tag="Error" x:Uid="LogFilterError" />
                        </ComboBox>
                        <TextBox x:Name="LogViewerText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="200" />
                        <Button x:Name="LogViewerRefreshButton" HorizontalAlignment="Stretch" Click="LogViewerRefresh_Click" x:Uid="LogViewerRefresh" />
                        <Button x:Name="LogViewerFolderButton" HorizontalAlignment="Stretch" Click="LogViewerFolder_Click" x:Uid="LogViewerFolder" />
                        <Button x:Name="LogViewerClearButton" HorizontalAlignment="Stretch" Click="LogViewerClear_Click" x:Uid="LogViewerClear" />
                        <TextBlock x:Name="LogViewerStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- About Section -->
            <Border x:Name="AboutCard" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" CornerRadius="8" />
                <StackPanel Margin="24" Spacing="8">
                    <TextBlock Text="ℹ️ About" Style="{StaticResource PageTitleTextStyle}"  x:Uid="Text_About_3e3c26" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="DMS" FontWeight="SemiBold" />
                        <TextBlock Text="v1.0.0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <TextBlock Text="WinUI 3 • .NET 10 • SQLite • Entity Framework Core" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Built for meal planning and recipe management" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" FontSize="12" Margin="0,4,0,0"  x:Uid="Text_Built_for_meal_planning_and_recipe_management_49409f" />
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
