<Page
    x:Class="DMS.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="600">
            <!-- Language Section -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="🌐 Language & Region" Style="{StaticResource PageTitleTextStyle}" />
                    <ComboBox x:Name="LanguageComboBox" Header="Language" SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Tag="bg" Content="🇧🇬 Bulgarian" />
                        <ComboBoxItem Tag="en" Content="🇺🇸 English" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Theme Section -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="🎨 Appearance" Style="{StaticResource PageTitleTextStyle}" />
                    <ComboBox x:Name="ThemeComboBox" Header="Theme" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="light" Content="☀️ Light" />
                        <ComboBoxItem Tag="dark" Content="🌙 Dark" />
                        <ComboBoxItem Tag="system" Content="💻 System Default" />
                    </ComboBox>
                    <ComboBox x:Name="AccentColorComboBox" Header="Accent Color" SelectionChanged="AccentColorComboBox_SelectionChanged" Margin="0,8,0,0">
                        <ComboBoxItem Tag="blue" Content="🔵 Blue" />
                        <ComboBoxItem Tag="green" Content="🟢 Green" />
                        <ComboBoxItem Tag="purple" Content="🟣 Purple" />
                        <ComboBoxItem Tag="orange" Content="🟠 Orange" />
                        <ComboBoxItem Tag="red" Content="🔴 Red" />
                        <ComboBoxItem Tag="teal" Content="🟢 Teal" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Data Management Section -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="💾 Data Management" Style="{StaticResource PageTitleTextStyle}" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportButton" Content="📤 Export Data" Click="ExportButton_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ImportButton" Content="📥 Import Data" Click="ImportButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BackupButton" Content="💾 Create Backup" Click="BackupButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                        <Button x:Name="RestoreButton" Content="🔄 Restore Backup" Click="RestoreButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="OpenDataFolderButton" Content="📁 Open Data Folder" Click="OpenDataFolderButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                        <TextBlock x:Name="DataFolderText" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Database Section -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="🗄️ Database" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="DatabaseInfoText" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="VacuumButton" Content="🧹 Vacuum Database" Click="VacuumButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                        <Button x:Name="ReindexButton" Content="📇 Reindex" Click="ReindexButton_Click" Style="{StaticResource ButtonRevealStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="ℹ️ About" Style="{StaticResource PageTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="DMS (Diet Management System)" FontWeight="SemiBold" />
                        <TextBlock Text="v1.0.0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <TextBlock Text="WinUI 3 • .NET 8 • SQLite • Entity Framework Core" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                    <TextBlock Text="Built for meal planning and recipe management" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>