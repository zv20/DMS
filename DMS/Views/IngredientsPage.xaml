<Page
    x:Class="DMS.Views.IngredientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,16,16,8" Spacing="8">
            <Button x:Name="AddIngredientButton" Content="➕ Add Ingredient" Click="AddIngredientButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Add_Ingredient_bc5b34" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search ingredients..." Width="300" QueryIcon="Find" TextChanged="SearchBox_TextChanged"  x:Uid="Text_Search_ingredients_540992" />
        </StackPanel>

        <!-- Ingredient List -->
        <ListView
            x:Name="IngredientsListView"
            Grid.Row="1"
            Padding="8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="IngredientsListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:IngredientItemViewModel">
                    <Border BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="16" />
                                <TextBlock Text="{x:Bind AllergensDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="✏️" ToolTipService.ToolTip="Edit" Click="EditIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Edit_530164" />
                                <Button Content="🗑️" ToolTipService.ToolTip="Delete" Click="DeleteIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"  x:Uid="Text_Delete_f6fdbe" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="🥕" FontSize="64" />
            <TextBlock Text="No ingredients yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"  x:Uid="Text_No_ingredients_yet_affb49" />
            <TextBlock Text="Click 'Add Ingredient' to create your first ingredient" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center"  x:Uid="Text_Click_Add_Ingredient_to_create_your_first_ingredient_49aa0b" />
        </StackPanel>
    </Grid>
</Page>
