<Page
    x:Class="DMS.Views.IngredientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EditorColumn" Width="0" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="ListToolbar" Grid.Row="0" Padding="16,16,16,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button x:Name="AddIngredientButton" Content="➕ Add Ingredient" Click="AddIngredientButton_Click" Style="{StaticResource AccentButtonStyle}"  x:Uid="Text_Add_Ingredient_bc5b34" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search ingredients..." QueryIcon="Find" TextChanged="SearchBox_TextChanged"  x:Uid="Text_Search_ingredients_540992" />
        </Grid>

        <TextBlock x:Name="PageStatus" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

        <!-- Ingredient List -->
        <ListView
            x:Name="IngredientsListView"
            Grid.Row="2"
            Padding="8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="IngredientsListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:IngredientItemViewModel">
                    <Border BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="16" />
                                <TextBlock Text="{x:Bind AllergensDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="✏️" ToolTipService.ToolTip="Edit" Click="EditIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}"  x:Uid="Text_Edit_530164" />
                                <Button Content="🗑️" ToolTipService.ToolTip="Delete" Click="DeleteIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"  x:Uid="Text_Delete_f6fdbe" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="🥕" FontSize="64" />
            <TextBlock Text="No ingredients yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"  x:Uid="Text_No_ingredients_yet_affb49" />
            <TextBlock Text="Click 'Add Ingredient' to create your first ingredient" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center"  x:Uid="Text_Click_Add_Ingredient_to_create_your_first_ingredient_49aa0b" />
        </StackPanel>
        <Border x:Name="EditorPanel" Grid.Column="1" Grid.RowSpan="3" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="EditorCloseButton" Grid.Column="1" Content="✕" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="EditorContent" Spacing="12" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EditorSaveButton" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EditorCancelButton" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
