<Page
    x:Class="DMS.Views.IngredientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,16,16,8" Spacing="8">
            <Button x:Name="AddIngredientButton" Content="➕ Add Ingredient" Click="AddIngredientButton_Click" Style="{StaticResource AccentButtonStyle}" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search ingredients..." Width="300" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <!-- Ingredient List -->
        <ListView
            x:Name="IngredientsListView"
            Grid.Row="1"
            Padding="16"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="IngredientsListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:IngredientItemViewModel">
                    <Border BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="18" />
                                <TextBlock Text="{x:Bind AllergensDisplay}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="✏️" ToolTipService.ToolTip="Edit" Click="EditIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" />
                                <Button Content="🗑️" ToolTipService.ToolTip="Delete" Click="DeleteIngredientButton_Click" Tag="{x:Bind Id}" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock Text="🥕" FontSize="64" />
            <TextBlock Text="No ingredients yet" Style="{StaticResource PageTitleTextStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Text="Click 'Add Ingredient' to create your first ingredient" Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>