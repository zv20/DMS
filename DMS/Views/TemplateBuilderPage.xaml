<Page x:Class="DMS.Views.TemplateBuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*">
        <!-- Document actions. -->
        <StackPanel>
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="12,6" Spacing="6">
                <Button x:Name="NewButton" Click="New_Click"><FontIcon Glyph="&#xE710;" /></Button>
                <Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"><FontIcon Glyph="&#xE74E;" /></Button>
                <Button x:Name="DeleteButton" Click="Delete_Click"><FontIcon Glyph="&#xE74D;" /></Button>
                <Button x:Name="UndoButton" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" /></Button>
                <Button x:Name="RedoButton" Click="Redo_Click"><FontIcon Glyph="&#xE7A6;" /></Button>
                <Border Width="1" Margin="3,4" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                <ComboBox x:Name="TemplateSelector" Width="170" SelectionChanged="TemplateSelector_SelectionChanged" DisplayMemberPath="Name" />
                <TextBox x:Name="NameBox" Width="170" />
                <CalendarDatePicker x:Name="PreviewDate" DateChanged="PreviewDate_DateChanged" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="LegacyNote" TextWrapping="Wrap" Visibility="Collapsed" Margin="12,0" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="12,0" />
        </StackPanel>

        <!-- Page tools sit alongside the document; selected-object tools remain on the canvas. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="6,8">
            <StackPanel Spacing="4">
                <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Spacing="5">
                        <TextBlock x:Name="SelectedElementLabel" Visibility="Collapsed" />
                        <ComboBox x:Name="SelectedFontBox" Width="145" Visibility="Collapsed" />
                        <NumberBox x:Name="SelectedSizeBox" Width="90" Minimum="7" Maximum="72" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />
                        <TextBox x:Name="SelectedColorBox" Width="100" PlaceholderText="#000000" Visibility="Collapsed" />
                        <ToggleButton x:Name="SelectedBoldButton" Content="B" FontWeight="Bold" Visibility="Collapsed" />
                        <ToggleButton x:Name="SelectedItalicButton" Content="I" FontStyle="Italic" Visibility="Collapsed" />
                        <ToggleButton x:Name="SelectedUnderlineButton" Visibility="Collapsed"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
                        <Button x:Name="EnableCanvasButton" Click="EnableCanvas_Click"><FontIcon Glyph="&#xE8A9;" /></Button>
                        <Button x:Name="EditTextButton" Click="EditText_Click"><FontIcon Glyph="&#xE70F;" /></Button>
                        <Button x:Name="ImageButton" Click="Image_Click"><FontIcon Glyph="&#xEB9F;" /></Button>
                        <Button x:Name="ClearImageButton" Click="ClearImage_Click"><FontIcon Glyph="&#xE74D;" /></Button>
                        <Button x:Name="ForwardButton" Click="Forward_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE74A;" /></Button>
                        <Button x:Name="BackwardButton" Click="Backward_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE74B;" /></Button>
                        <Button x:Name="RemoveLayerButton" Click="RemoveLayer_Click" Visibility="Collapsed"><FontIcon Glyph="&#xE74D;" /></Button>
                        <ComboBox x:Name="ImageLayerSelector" Width="120" SelectionChanged="ImageLayerSelector_SelectionChanged" Visibility="Collapsed" />
                        <Button x:Name="PageOptionsButton">
                            <FontIcon Glyph="&#xE713;" />
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Width="260" Spacing="8">
                                            <ComboBox x:Name="FontBox" />
                                            <NumberBox x:Name="HeaderSizeBox" Minimum="8" Maximum="72" SpinButtonPlacementMode="Compact" />
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ToggleButton x:Name="HeaderBoldButton" Content="B" FontWeight="Bold" />
                                                <ToggleButton x:Name="HeaderItalicButton" Content="I" FontStyle="Italic" />
                                                <ToggleButton x:Name="HeaderUnderlineButton"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
                                            </StackPanel>
                                            <ComboBox x:Name="HeaderAlignmentBox" />
                                            <TextBox x:Name="HeaderColorBox" PlaceholderText="#D2691E" />
                                            <NumberBox x:Name="MealSizeBox" Minimum="7" Maximum="36" SpinButtonPlacementMode="Compact" />
                                            <ComboBox x:Name="LayoutBox" />
                                            <ComboBox x:Name="FooterAlignmentBox" />
                                            <NumberBox x:Name="FooterSizeBox" Minimum="7" Maximum="36" SpinButtonPlacementMode="Compact" />
                                            <TextBox x:Name="BackgroundColorBox" PlaceholderText="#FFFFFF" />
                                            <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="VisibilityButton">
                            <FontIcon Glyph="&#xE890;" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="4">
                                        <CheckBox x:Name="ShowHeaderBox" /><CheckBox x:Name="ShowDateBox" />
                                        <CheckBox x:Name="ShowIngredientsBox" /><CheckBox x:Name="ShowCaloriesBox" />
                                        <CheckBox x:Name="ShowPortionsBox" /><CheckBox x:Name="ShowFooterBox" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- The page remains independently scrollable at smaller window sizes. -->
        <ScrollViewer Grid.Column="0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <Border x:Name="PreviewBorder" Width="794" MinHeight="1123" Background="White" HorizontalAlignment="Center">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" Margin="38" />
                    <Grid x:Name="LegacyPage" Margin="38" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Button x:Name="HeaderDisplayButton" Click="HeaderDisplay_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32">
                            <TextBlock x:Name="HeaderDisplay" TextWrapping="Wrap" />
                        </Button>
                        <TextBox x:Name="HeaderBox" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="HeaderBox_LostFocus" />
                        <StackPanel x:Name="PreviewPanel" Grid.Row="1" Spacing="8" />
                        <Button x:Name="FooterDisplayButton" Grid.Row="2" Click="FooterDisplay_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32">
                            <TextBlock x:Name="FooterDisplay" TextWrapping="Wrap" />
                        </Button>
                        <TextBox x:Name="FooterBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="FooterBox_LostFocus" />
                    </Grid>
                    <Canvas x:Name="LayoutCanvas" Width="794" Height="1123" Background="Transparent" Visibility="Collapsed"
                            PointerPressed="LayoutCanvas_PointerPressed" />
                </Grid>
            </Border>
        </ScrollViewer>
        </Grid>
    </Grid>
</Page>
