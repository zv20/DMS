<Page x:Class="DMS.Views.TemplateBuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- File actions and document selection. -->
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,10" Spacing="8">
                <Button x:Name="NewButton" Click="New_Click" />
                <Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
                <ComboBox x:Name="TemplateSelector" Width="200" SelectionChanged="TemplateSelector_SelectionChanged" DisplayMemberPath="Name" />
                <TextBox x:Name="NameBox" Width="200" />
                <Button x:Name="DeleteButton" Click="Delete_Click" />
                <CalendarDatePicker x:Name="PreviewDate" DateChanged="PreviewDate_DateChanged" />
            </StackPanel>
        </ScrollViewer>

        <!-- Formatting and page tools, available above the document canvas. -->
        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="16,8">
            <StackPanel Spacing="8">
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock x:Name="SelectedElementLabel" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                        <ComboBox x:Name="SelectedFontBox" Width="150" />
                        <NumberBox x:Name="SelectedSizeBox" Width="110" Minimum="7" Maximum="72" SpinButtonPlacementMode="Compact" />
                        <TextBox x:Name="SelectedColorBox" Width="110" PlaceholderText="#000000" />
                        <ToggleButton x:Name="SelectedBoldButton" Content="B" FontWeight="Bold" VerticalAlignment="Bottom" />
                        <ToggleButton x:Name="SelectedItalicButton" Content="I" FontStyle="Italic" VerticalAlignment="Bottom" />
                        <ToggleButton x:Name="SelectedUnderlineButton" Content="U" VerticalAlignment="Bottom" />
                        <ComboBox x:Name="FontBox" Width="170" />
                        <NumberBox x:Name="HeaderSizeBox" Width="115" Minimum="8" Maximum="72" SpinButtonPlacementMode="Compact" />
                        <ToggleButton x:Name="HeaderBoldButton" Content="B" FontWeight="Bold" VerticalAlignment="Bottom" />
                        <ToggleButton x:Name="HeaderItalicButton" Content="I" FontStyle="Italic" VerticalAlignment="Bottom" />
                        <ToggleButton x:Name="HeaderUnderlineButton" Content="U" VerticalAlignment="Bottom" />
                        <ComboBox x:Name="HeaderAlignmentBox" Width="130" />
                        <TextBox x:Name="HeaderColorBox" Width="120" PlaceholderText="#D2691E" />
                        <NumberBox x:Name="MealSizeBox" Width="115" Minimum="7" Maximum="36" SpinButtonPlacementMode="Compact" />
                        <ComboBox x:Name="LayoutBox" Width="170" />
                        <ComboBox x:Name="FooterAlignmentBox" Width="130" />
                        <NumberBox x:Name="FooterSizeBox" Width="115" Minimum="7" Maximum="36" SpinButtonPlacementMode="Compact" />
                        <TextBox x:Name="BackgroundColorBox" Width="120" PlaceholderText="#FFFFFF" />
                        <Button x:Name="ImageButton" Click="Image_Click" VerticalAlignment="Bottom" />
                        <Button x:Name="ClearImageButton" Click="ClearImage_Click" VerticalAlignment="Bottom" />
                        <Slider x:Name="ImageOpacitySlider" Width="120" Minimum="0" Maximum="100" StepFrequency="5" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="ShowHeaderBox" /><CheckBox x:Name="ShowDateBox" />
                        <CheckBox x:Name="ShowIngredientsBox" /><CheckBox x:Name="ShowCaloriesBox" />
                        <CheckBox x:Name="ShowPortionsBox" /><CheckBox x:Name="ShowFooterBox" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="LegacyNote" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- The page remains independently scrollable at smaller window sizes. -->
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <Border x:Name="PreviewBorder" Width="794" MinHeight="1123" Background="White" Padding="38" HorizontalAlignment="Center">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Button x:Name="HeaderDisplayButton" Click="HeaderDisplay_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32">
                            <TextBlock x:Name="HeaderDisplay" TextWrapping="Wrap" />
                        </Button>
                        <TextBox x:Name="HeaderBox" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="HeaderBox_LostFocus" />
                        <StackPanel x:Name="PreviewPanel" Grid.Row="1" Spacing="8" />
                        <Button x:Name="FooterDisplayButton" Grid.Row="2" Click="FooterDisplay_Click" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32">
                            <TextBlock x:Name="FooterDisplay" TextWrapping="Wrap" />
                        </Button>
                        <TextBox x:Name="FooterBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" LostFocus="FooterBox_LostFocus" />
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
