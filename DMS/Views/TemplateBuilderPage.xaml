<Page x:Class="DMS.Views.TemplateBuilderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Page.Resources>
  <DataTemplate x:Key="SettingsLabelTemplate">
   <TextBlock Text="{Binding}" TextWrapping="Wrap" />
  </DataTemplate>
 </Page.Resources>
 <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
  <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
   <StackPanel Orientation="Horizontal" Padding="12,8" Spacing="8">
    <DropDownButton x:Name="FileMenuButton" VerticalAlignment="Bottom">
     <DropDownButton.Content><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE700;" FontSize="14" /><TextBlock x:Name="FileMenuLabel" /></StackPanel></DropDownButton.Content>
     <DropDownButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft">
      <MenuFlyoutItem x:Name="NewButton" Click="New_Click" />
      <MenuFlyoutSubItem x:Name="SavedTemplatesMenu" />
      <MenuFlyoutItem x:Name="SaveButton" Click="Save_Click" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False" />
     </MenuFlyout></DropDownButton.Flyout>
    </DropDownButton>
    <CalendarDatePicker x:Name="WeekPicker" VerticalAlignment="Bottom" DateChanged="WeekPicker_DateChanged" />
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="Workspace" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto,Auto">
   <ScrollViewer x:Name="PageScroll" Background="Transparent" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" Padding="24"><ContentControl x:Name="PageHost" HorizontalAlignment="Center" /></ScrollViewer>
   <Border x:Name="SettingsPanel" Grid.Column="1" Grid.RowSpan="3" Width="270" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"><Grid><Border Background="{ThemeResource DmsClassicSurfaceOverlayBrush}" /><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="12"><StackPanel Spacing="10">
    <Expander x:Name="LayoutHeading" IsExpanded="True" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" HeaderTemplate="{StaticResource SettingsLabelTemplate}">
     <StackPanel Spacing="10">
    <NumberBox x:Name="DaySpacingBox" Minimum="0" Maximum="40" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Numbers_Changed" />
    <NumberBox x:Name="MealSpacingBox" Minimum="0" Maximum="20" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Numbers_Changed" />
    <CheckBox x:Name="HideEmptyDaysBox" MinWidth="0" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Checked="HideEmptyDays_Changed" Unchecked="HideEmptyDays_Changed" />
    <TextBlock x:Name="DayHeightsHeading" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBlock x:Name="DayHint" TextWrapping="Wrap" /><StackPanel x:Name="DayControls" Spacing="6" />
     </StackPanel>
    </Expander>
    <Expander x:Name="ImagesHeading" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" HeaderTemplate="{StaticResource SettingsLabelTemplate}">
     <StackPanel Spacing="10">
    <Button x:Name="ChooseImageButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Click="ChooseImage_Click" />
    <Button x:Name="ClearImageButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Click="ClearImage_Click" />
    <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="ImageOpacity_Changed" />
    <Button x:Name="AddDecorationButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Click="AddDecoration_Click" />
    <ComboBox x:Name="DecorationSelector" HeaderTemplate="{StaticResource SettingsLabelTemplate}" SelectionChanged="DecorationSelector_SelectionChanged" HorizontalAlignment="Stretch" />
    <Button x:Name="RemoveDecorationButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Click="RemoveDecoration_Click" />
    <NumberBox x:Name="DecorationX" Minimum="0" Maximum="794" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Decoration_Changed" />
    <NumberBox x:Name="DecorationY" Minimum="0" Maximum="1123" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Decoration_Changed" />
    <NumberBox x:Name="DecorationWidth" Minimum="1" Maximum="794" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Decoration_Changed" />
    <NumberBox x:Name="DecorationHeight" Minimum="1" Maximum="1123" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Decoration_Changed" />
    <CheckBox x:Name="DecorationReserve" MinWidth="0" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Checked="DecorationReserve_Changed" Unchecked="DecorationReserve_Changed" />
     </StackPanel>
    </Expander>
   </StackPanel></ScrollViewer></Grid></Border>
   <Canvas x:Name="SelectionOverlay" Grid.Column="0" Canvas.ZIndex="10">
    <Border x:Name="SelectionOutline" IsHitTestVisible="False" BorderBrush="DodgerBlue" BorderThickness="2" Visibility="Collapsed" />
    <TextBox x:Name="InlineEditor" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed" />
    <Border x:Name="SelectionToolbar" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="1" CornerRadius="6" Padding="5" Visibility="Collapsed">
     <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><StackPanel x:Name="ContextTools" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
    </Border>
   </Canvas>
   <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" Padding="8,4">
     <Button x:Name="ZoomOutButton" Content="−" />
     <Slider x:Name="CanvasZoomSlider" Width="120" Minimum="50" Maximum="200" StepFrequency="10" Value="100" />
     <Button x:Name="ZoomResetButton" Content="100%" />
     <Button x:Name="ZoomInButton" Content="+" />
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="12,6" Spacing="2">
   <TextBlock x:Name="InlineEditHint" TextWrapping="Wrap" />
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
  </StackPanel>
 </Grid>
</Page>
