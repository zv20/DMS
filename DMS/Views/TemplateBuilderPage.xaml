<Page x:Class="DMS.Views.TemplateBuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*">
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" Padding="16,12" Spacing="8">
                <Button x:Name="NewButton" Click="New_Click" />
                <Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
                <ComboBox x:Name="TemplateSelector" Width="240" SelectionChanged="TemplateSelector_SelectionChanged" DisplayMemberPath="Name" />
                <Button x:Name="DeleteButton" Click="Delete_Click" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16" Padding="16,0,16,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBox x:Name="NameBox" />
                    <TextBox x:Name="HeaderBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="HeaderBoldButton" Content="B" FontWeight="Bold" />
                        <ToggleButton x:Name="HeaderItalicButton" Content="I" FontStyle="Italic" />
                        <ToggleButton x:Name="HeaderUnderlineButton" Content="U" />
                        <ComboBox x:Name="HeaderAlignmentBox" Width="150" />
                    </StackPanel>
                    <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" />
                    <NumberBox x:Name="HeaderSizeBox" Minimum="8" Maximum="72" SpinButtonPlacementMode="Inline" />
                    <NumberBox x:Name="MealSizeBox" Minimum="7" Maximum="36" SpinButtonPlacementMode="Inline" />
                    <TextBox x:Name="HeaderColorBox" PlaceholderText="#D2691E" />
                    <TextBox x:Name="FooterBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
                    <ComboBox x:Name="FooterAlignmentBox" HorizontalAlignment="Stretch" />
                    <NumberBox x:Name="FooterSizeBox" Minimum="7" Maximum="36" SpinButtonPlacementMode="Inline" />
                    <TextBox x:Name="BackgroundColorBox" PlaceholderText="#FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ImageButton" Click="Image_Click" />
                        <Button x:Name="ClearImageButton" Click="ClearImage_Click" />
                    </StackPanel>
                    <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" />
                    <CheckBox x:Name="ShowHeaderBox" />
                    <CheckBox x:Name="ShowDateBox" />
                    <CheckBox x:Name="ShowIngredientsBox" />
                    <CheckBox x:Name="ShowCaloriesBox" />
                    <CheckBox x:Name="ShowPortionsBox" />
                    <CheckBox x:Name="ShowFooterBox" />
                    <TextBlock x:Name="LegacyNote" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <TextBlock x:Name="PreviewLabel" VerticalAlignment="Center" />
                    <CalendarDatePicker x:Name="PreviewDate" DateChanged="PreviewDate_DateChanged" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border x:Name="PreviewBorder" Width="650" MinHeight="800" Background="White" Padding="32">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                            <StackPanel x:Name="PreviewPanel" Spacing="8" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
