<Page x:Class="DMS.Views.TemplateBuilderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Page.Resources>
  <DataTemplate x:Key="SettingsLabelTemplate">
   <TextBlock Text="{Binding}" TextWrapping="Wrap" />
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="Workspace" RowDefinitions="Auto,*,Auto" Background="Transparent">
  <Grid ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="8">
   <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <DropDownButton x:Name="FileMenuButton" VerticalAlignment="Bottom">
     <DropDownButton.Content><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE700;" FontSize="14" /><TextBlock x:Name="FileMenuLabel" /></StackPanel></DropDownButton.Content>
     <DropDownButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="FileMenu_Opening" Closed="FileMenu_Closed">
      <MenuFlyoutSubItem x:Name="SelectBlockMenu" />
      <MenuFlyoutItem x:Name="NewButton" Click="New_Click" />
      <MenuFlyoutItem x:Name="SavedTemplatesMenu" Click="BrowseTemplates_Click" />
      <MenuFlyoutItem x:Name="SaveButton" Click="Save_Click" />
      <MenuFlyoutItem x:Name="RenameTemplateMenuItem" Click="RenameTemplate_Click" IsEnabled="False" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem x:Name="AddImageMenuItem" Click="AddDecoration_Click" />
      <MenuFlyoutItem x:Name="ImageLibraryMenuItem" Click="ImageLibrary_Click" />
      <MenuFlyoutSubItem x:Name="PageImagesMenu" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False" />
     </MenuFlyout></DropDownButton.Flyout>
    </DropDownButton>
    <CalendarDatePicker x:Name="WeekPicker" VerticalAlignment="Bottom" DateChanged="WeekPicker_DateChanged" />
   <Button x:Name="UndoButton" Content="↶" MinWidth="32" />
   <Button x:Name="RedoButton" Content="↷" MinWidth="32" />
   <StackPanel x:Name="PreviewPageNavigation" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
    <Button x:Name="PreviousPreviewPageButton" Content="‹" Click="PreviousPreviewPage_Click" />
    <TextBlock x:Name="PreviewPageNumber" VerticalAlignment="Center" />
    <Button x:Name="NextPreviewPageButton" Content="›" Click="NextPreviewPage_Click" />
   </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <DropDownButton x:Name="CanvasSettingsButton" Grid.Column="1" VerticalAlignment="Center">
    <DropDownButton.Flyout>
     <Flyout Placement="BottomEdgeAlignedRight">
      <ScrollViewer Width="280" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
       <StackPanel Spacing="10">
        <NumberBox x:Name="DaySpacingBox" Minimum="0" Maximum="40" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Numbers_Changed" />
        <NumberBox x:Name="MealSpacingBox" Minimum="0" Maximum="20" HeaderTemplate="{StaticResource SettingsLabelTemplate}" ValueChanged="Numbers_Changed" />
        <CheckBox x:Name="HideEmptyDaysBox" MinWidth="0" HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource SettingsLabelTemplate}" Checked="HideEmptyDays_Changed" Unchecked="HideEmptyDays_Changed" />
        <TextBlock x:Name="DayHeightsHeading" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock x:Name="DayHint" TextWrapping="Wrap" /><StackPanel x:Name="DayControls" Spacing="6" />
       </StackPanel>
      </ScrollViewer>
     </Flyout>
    </DropDownButton.Flyout>
   </DropDownButton>
  </Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" Background="Transparent" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" Padding="24"><ContentControl x:Name="PageHost" HorizontalAlignment="Center" /></ScrollViewer>
    <ScrollViewer x:Name="StatusPanel" Grid.Row="2" Margin="12,0,12,8" MaxHeight="144" Visibility="Collapsed" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </ScrollViewer>
   <Canvas x:Name="SelectionOverlay" Grid.Row="1" Canvas.ZIndex="10">
    <Border x:Name="SelectionOutline" IsHitTestVisible="False" BorderBrush="DodgerBlue" BorderThickness="2" Visibility="Collapsed" />
    <TextBox x:Name="InlineEditor" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed" />
    <Border x:Name="SelectionToolbar" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="1" CornerRadius="10" Padding="5" Visibility="Collapsed">
     <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><StackPanel x:Name="ContextTools" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
    </Border>
   </Canvas>
  <Border Grid.Row="1" Canvas.ZIndex="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="0,0,20,20" CornerRadius="{ThemeResource ControlCornerRadius}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{ThemeResource SystemControlForegroundListLowBrush}" BorderThickness="1">
   <Grid Width="220" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" Padding="8,4">
    <Button x:Name="ZoomOutButton" Content="−" MinWidth="32" />
    <Slider x:Name="CanvasZoomSlider" Grid.Column="1" MinWidth="0" Minimum="50" Maximum="200" StepFrequency="10" Value="70" />
    <Button x:Name="ZoomResetButton" Grid.Column="2" Content="100%" MinWidth="48" />
    <Button x:Name="ZoomInButton" Grid.Column="3" Content="+" MinWidth="32" />
   </Grid>
  </Border>
 </Grid>
</Page>
