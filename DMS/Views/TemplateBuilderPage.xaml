<Page
    x:Class="DMS.Views.TemplateBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DMS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,16,16,8" Spacing="8">
            <Button x:Name="NewTemplateButton" Content="➕ New Template" Click="NewTemplateButton_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="SaveTemplateButton" Content="💾 Save Template" Click="SaveTemplateButton_Click" Style="{StaticResource ButtonRevealStyle}" Margin="8,0,0,0" />
            <Button x:Name="LoadTemplateButton" Content="📂 Load Template" Click="LoadTemplateButton_Click" Style="{StaticResource ButtonRevealStyle}" />
            <ComboBox x:Name="TemplateSelector" Width="250" PlaceholderText="Select template..." SelectionChanged="TemplateSelector_SelectionChanged" Margin="16,0,0,0" />
            <Button x:Name="DeleteTemplateButton" Content="🗑️ Delete" Click="DeleteTemplateButton_Click" Style="{StaticResource ButtonRevealStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Template Editor -->
            <ScrollViewer Grid.Column="0" HorizontalScrollMode="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="16">
                    <!-- Template Name -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Template Name" Style="{StaticResource PageTitleTextStyle}" FontSize="14" />
                        <TextBox x:Name="TemplateNameBox" PlaceholderText="My Weekly Menu Template" />
                    </StackPanel>

                    <!-- Header Text -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Header Text" Style="{StaticResource PageTitleTextStyle}" FontSize="14" />
                        <TextBox x:Name="HeaderTextBox" PlaceholderText="Weekly Menu" />
                    </StackPanel>

                    <!-- Footer Text -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Footer Text" Style="{StaticResource PageTitleTextStyle}" FontSize="14" />
                        <TextBox x:Name="FooterTextBox" PlaceholderText="Prepared with care by DMS" />
                    </StackPanel>

                    <!-- Background Color -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Background Color" Style="{StaticResource PageTitleTextStyle}" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="BackgroundColorBox" Text="#FFFFFF" Width="150" PlaceholderText="#FFFFFF" />
                            <Border x:Name="BgColorPreview" Width="40" Height="40" Background="White" CornerRadius="4" BorderBrush="Gray" BorderThickness="1" />
                            <Button Content="Pick Color" Click="PickBackgroundColor_Click" Style="{StaticResource ButtonRevealStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Week Structure -->
                    <TextBlock Text="Week Structure" Style="{StaticResource PageTitleTextStyle}" FontSize="14" />
                    <StackPanel x:Name="WeekStructurePanel" Spacing="8" />
                </StackPanel>
            </ScrollViewer>

            <!-- Divider -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource SystemControlForegroundListLowBrush}" VerticalAlignment="Stretch" Margin="0,16" />

            <!-- Live Preview -->
            <Border Grid.Column="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="8" Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Live Preview" Style="{StaticResource PageTitleTextStyle}" FontSize="14" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto">
                        <Border x:Name="PreviewBorder" Background="White" CornerRadius="4" Padding="16">
                            <StackPanel x:Name="PreviewPanel" Spacing="12" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>