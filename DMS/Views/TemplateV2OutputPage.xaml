<Page x:Class="DMS.Views.TemplateV2OutputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Padding="16,12" Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="TemplateSelector" MinWidth="180" DisplayMemberPath="Name" SelectionChanged="TemplateSelector_SelectionChanged" />
                <CalendarDatePicker x:Name="WeekPicker" DateChanged="WeekPicker_DateChanged" />
                <Button x:Name="PrintButton" Click="Print_Click" IsEnabled="False" />
                <Button x:Name="PdfButton" Click="Pdf_Click" IsEnabled="False" />
                <Button x:Name="PngButton" Click="Png_Click" IsEnabled="False" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,8" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <ContentControl x:Name="PreviewHost" HorizontalAlignment="Center" />
        </ScrollViewer>
    </Grid>
</Page>
