<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DMS" Manufacturer="DMS" Version="$(var.Version)"
           UpgradeCode="8739DAA3-B371-4A7C-8D98-19D6F030D77D" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DMS is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <!-- Keep MSI-owned files separate from the former Inno installation. -->
        <Directory Id="INSTALLFOLDER" Name="DMS-MSI" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="DMS">
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut Id="DmsShortcut" Name="DMS" Target="[INSTALLFOLDER]DMS.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DMS\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
